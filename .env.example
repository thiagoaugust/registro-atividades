# Copie para .env antes do primeiro `docker compose up`.

# Senha do unico usuario do sistema (login: admin).
APP_PASSWORD=troque-esta-senha

# Use demo,prod para subir com ~120 dias de dados de exemplo (so com o banco vazio).
QUARKUS_PROFILE=prod

# Postgres do docker compose.
POSTGRES_DB=registro
POSTGRES_USER=registro
POSTGRES_PASSWORD=registro
